# Documents the environment variables used by the SSMEAS backend.
PORT=4000

# Use DATABASE_URL or the individual PostgreSQL connection fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ssmeas
DB_USER=postgres
DB_PASSWORD=********

# Backend-only credentials for retrieving the latest ThingSpeak channel feed.
THINGSPEAK_CHANNEL_ID=*********
THINGSPEAK_READ_API_KEY=*********

# Automatic alert thresholds.
FILL_WARNING_THRESHOLD=80
FILL_CRITICAL_THRESHOLD=95
GAS_LEVEL_THRESHOLD=300
LOW_BATTERY_THRESHOLD=3.3

# Minutes after a critical sensor reading before its automatic field task is due.
CRITICAL_MAINTENANCE_DELAY_MINUTES=30

# Maintenance vehicle depot used as the route optimization starting point.
DEPOT_LATITUDE=0.3476
DEPOT_LONGITUDE=32.5825
DISPOSAL_SITE_NAME=Bugolobi Wastewater Treatment Plant
DISPOSAL_SITE_LATITUDE=0.3165
DISPOSAL_SITE_LONGITUDE=32.6224
TRUCK_CAPACITY_LITERS=10000
DISPOSAL_UNLOADING_MINUTES=30
ROUTE_SHIFT_DURATION_MINUTES=480
ROUTE_SERVICE_MINUTES_PER_TANK=20
ROUTE_EMERGENCY_SERVICE_MINUTES=30

# Use a dedicated/self-hosted OSRM instance in production. The public endpoint is a development fallback.
ROUTING_API_BASE_URL=https://router.project-osrm.org
ROUTING_API_TIMEOUT_MS=8000

# JWT authentication. Use a long, random secret in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

#device API
DEVICE_API_KEY=replace-with-a-long-random-secret

# SMTP email delivery (Nodemailer).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@ssmeas.local
# SMS uses MockSmsProvider in development. Inject a production SmsProvider
# implementation (for example Africa's Talking or Twilio) at deployment time.
SMS_SENDER_ID=SSMEAS
NOTIFICATION_REMINDER_INTERVAL_MINUTES=30
# Active alerts are not resent by default. Set true only when periodic reminders are desired.
NOTIFICATION_REMINDERS_ENABLED=false
